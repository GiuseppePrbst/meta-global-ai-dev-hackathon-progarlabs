# Solo configuración PÚBLICA: Expo incrusta toda variable EXPO_PUBLIC_* en el bundle.
# Nunca poner aquí tokens de operador, invitaciones, claves de Meta ni credenciales.
# Copiar a .env.local (ignorado por git) y reiniciar `expo start`.
EXPO_PUBLIC_API_URL=https://api-bosquevivo.progarlabs.com

# Wilo (POST /guide/query y /guide/transcribe). Sin esta variable, o con cualquier valor distinto de
# `true`, la app SIMULA las llamadas (src/api/mock/wilo-mock.ts) y nada sale del teléfono.
# Con `true` llama a la API real: consume presupuesto compartido de Meta (límite por IP) y termina
# el 2026-11-10T05:00:00Z. La voz se graba como WAV de 16 kHz en iOS, Android y web (wav.ts).
EXPO_PUBLIC_WILO_LIVE=false

# Identificar (POST /identify). Igual que Wilo: sin `true`, la app SIMULA la llamada
# (src/api/mock/identify-mock.ts), propone una especie al azar del catálogo y la foto no sale del
# teléfono. Con `true` la foto se envía a Meta Model API y consume presupuesto compartido.
EXPO_PUBLIC_IDENTIFY_LIVE=false
