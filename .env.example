# Development only. Copy to .env; never commit real values.
POSTGRES_DB=bosque
POSTGRES_USER=bosque
POSTGRES_PASSWORD=local-development-only
# Empty: API/catalog work without a DB; observation endpoints return 503.
DATABASE_URL=
# Compose build argument. For local Next, set this in apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
AI_PROVIDER=mock
MODEL_API_KEY=
META_TIMEOUT_SECONDS=30
# Local authorized use only; keep MODEL_API_KEY in process environment or ignored .env.
META_ENABLED=false
META_MODEL=muse-spark-1.3
META_ACCESS_TOKEN=
META_MIN_INTERVAL_SECONDS=60
SAM_ENABLED=false
SAM_MODEL=sam-3.1
# Absolute path to a reviewed manifest outside the repository; install API extra raster.
FOREST_MANIFEST=
