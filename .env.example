# Development only. Copy to .env; never commit real values.
POSTGRES_DB=bosque
POSTGRES_USER=bosque
POSTGRES_PASSWORD=local-development-only
# Empty: API/catalog work without a DB; observation endpoints return 503.
DATABASE_URL=
# Compose build argument. For local Next, set this in apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
AI_PROVIDER=mock
MODEL_API_KEY=
META_TIMEOUT_SECONDS=30
# Local authorized use only; keep MODEL_API_KEY in process environment or ignored .env.
META_ENABLED=false
META_MODEL=muse-spark-1.3
META_ACCESS_TOKEN=
META_MIN_INTERVAL_SECONDS=60
SAM_ENABLED=false
SAM_MODEL=sam-3.1
# Absolute path to a reviewed manifest outside the repository; install API extra raster.
FOREST_MANIFEST=
# Local is loopback-only development. Expeditions require SQL 001–004 and private demo credentials.
SERVICE_MODE=local
DEMO_TOKENS={}
BUDGET_REQUESTS=20
BUDGET_REQUESTS_PER_IDENTITY=5
BUDGET_CONCURRENCY=1
# Explicit conservative reservation units; zero keeps paid demo inference disabled.
BUDGET_UNITS=0
META_RESERVATION_UNITS=0
# Voice: one WAV <=60 s. Guide: at most two Muse generations plus four read tools.
VOICE_RESERVATION_UNITS=0
GUIDE_RESERVATION_UNITS=0
OBSERVATION_RETENTION_DAYS=30
RASTER_TIMEOUT_SECONDS=15

# Open-set identification strategy: verify (default, evaluated 30-10-2026) | abstain | comparators | baseline
IDENTIFY_STRATEGY=verify
