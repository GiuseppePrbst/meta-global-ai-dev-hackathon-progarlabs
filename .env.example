# Development only. Copy to .env; never commit real values.
POSTGRES_DB=bosque
POSTGRES_USER=bosque
POSTGRES_PASSWORD=local-development-only
# Empty: API/catalog work without a DB; observation endpoints return 503.
DATABASE_URL=
# Compose build argument. For local Next, set this in apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
AI_PROVIDER=mock
MODEL_API_KEY=
META_TIMEOUT_SECONDS=30
